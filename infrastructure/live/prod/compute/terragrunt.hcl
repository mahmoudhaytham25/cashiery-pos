include "root" {
  path = find_in_parent_folders("root.hcl")
}

terraform {
  source = "${get_repo_root()}/infrastructure//modules/compute"
}

dependency "ecr" {
  config_path = "../../shared/ecr"

  mock_outputs_allowed_terraform_commands = ["validate", "plan"]
  mock_outputs = {
    ecr_registry             = "000000000000.dkr.ecr.us-east-1.amazonaws.com"
    backend_repository_name  = "mock-backend"
    frontend_repository_name = "mock-frontend"
  }
}

inputs = {
  environment   = "prod"
  instance_type = "t3.micro"
  repo_ref      = "main"

  # Boot onto the last dev-verified image — prod-<sha>/prod-latest don't
  # exist until the first promote, which then rewrites IMAGE_TAG in .env.
  image_tag = "dev-latest"

  seed_products = false # real-data framing — no demo catalog on prod

  ecr_registry      = dependency.ecr.outputs.ecr_registry
  ecr_backend_repo  = dependency.ecr.outputs.backend_repository_name
  ecr_frontend_repo = dependency.ecr.outputs.frontend_repository_name

  # Optional overrides:
  # ssh_cidr = "1.2.3.4/32"   # your IP, if you want port 22
  # key_name = "my-keypair"
  # JWT_SECRET / POSTGRES_PASSWORD are generated by Terraform — see outputs.
}
