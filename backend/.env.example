DB_HOST=localhost
# DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
JWT_SECRET=your_random_secure_jwt_secret

# Optional: allowed CORS origin for the API (defaults to http://localhost:3000).
# In docker-compose the frontend is served through nginx's /api proxy, so
# requests are same-origin and CORS isn't exercised.
# ALLOWED_ORIGIN=http://localhost:3000

# Optional: full Postgres connection URL for `npm run migrate:*`
# (node-pg-migrate). When unset, scripts/migrate.js derives it from the
# DB_* vars above — set it only if you need something those can't express.
# DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/your_db_name
